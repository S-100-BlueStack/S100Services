<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.20348.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)DataCatalogue.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <ProjectReference Include="../../src/DataCatalogueAPI/DataCatalogueAPI.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../src/DataCatalogueAPI/s100ed17.zip" Link="s100ed17.zip" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../src/DataCatalogueAPI/s100ed17.zip')" />
    <Content Include="../../src/DataCatalogueAPI/Samples/NoticesToMariners/*.json" Link="Samples/NoticesToMariners/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/DataCatalogueAPI/Samples/GeneralSubmission/*.zip" Link="Samples/GeneralSubmission/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
