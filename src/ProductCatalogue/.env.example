# Development can point directly to the local backend while testing.
# Production should normally use same-origin /api.
VITE_API_BASE_URL=/api

# Optional local backend target. This is reserved for a Vite dev proxy
# if the dev setup later switches away from browser-direct localhost calls.
VITE_DEV_API_TARGET=https://localhost:7271

# ArcGIS portal used by the Maps SDK. Non-secret Vite build input.
# Blank, missing, invalid, or unsupported values use https://www.arcgis.com.
VITE_ARCGIS_PORTAL_URL=https://www.arcgis.com

# Main-map geographic Locator service. Leave blank or remove it to fail closed.
VITE_ARCGIS_LOCATOR_URL=https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer

# Optional branding. Non-secret Vite build inputs: rebuild and redeploy after config changes.
# Blank URLs use neutral Product Catalogue assets. Blank alt uses Product Catalogue.
# Replacing files at unchanged URLs only requires refresh, subject to deployment cache policy.
VITE_APP_LOGO_URL=
VITE_APP_LOGO_ALT=
VITE_APP_FAVICON_URL=