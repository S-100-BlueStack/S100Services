<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.20348.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="exports\**" />
    <Compile Remove="s100ed9.gdb\**" />
    <Content Remove="exports\**" />
    <Content Remove="s100ed9.gdb\**" />
    <EmbeddedResource Remove="exports\**" />
    <EmbeddedResource Remove="s100ed9.gdb\**" />
    <None Remove="exports\**" />
    <None Remove="s100ed9.gdb\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="101_Feature_Catalogue_2.0.0.xml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="101_Feature_Catalogue_2.0.0.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Versioning" Version="5.1.0" />
    <PackageReference Include="S100Framework.ArcGIS.Core" Version="2.1.12" />
    <PackageReference Include="S100Framework.Catalogues" Version="2.1.25" />
    <PackageReference Include="S100Framework.ProductCatalogue" Version="2.0.0" />
    <PackageReference Include="S100Framework.YAML" Version="2.0.2" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.4" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ArcGIS.Core">
      <HintPath>C:\Program Files\ArcGIS\Pro\bin\ArcGIS.Core.dll</HintPath>
    </Reference>
    <Reference Include="ArcGIS.CoreHost">
      <HintPath>C:\Program Files\ArcGIS\Pro\bin\ArcGIS.CoreHost.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="s100ed9.gdb.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
