# Browser-visible configuration only. Never add credentials or tokens.
# mock preserves the existing prototype. live never falls back to demo data.
VITE_CATALOGUE_SOURCE=mock

# Empty means same origin. Otherwise use an approved API origin and optional hosting prefix.
# The client appends /api/v1/... itself. Do not include /api/v1 here.
VITE_CATALOGUE_API_BASE_URL=
VITE_CATALOGUE_API_CREDENTIALS=same-origin

# Existing demo geography configuration; not used as live Package/Workspace mapping.
VITE_AOI_FEATURE_SERVICE_URL=
VITE_WORK_STREAM_MAP_SERVICE_URL=
VITE_ARCGIS_PORTAL_URL=
