<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpenApiDemo.Api</RootNamespace>
    <AssemblyName>OpenApiDemo.Api</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      Required for the built-in .NET 10 OpenAPI XML comment support: triple-slash
      documentation on controllers, actions and models is lifted straight into the
      generated OpenAPI documents.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- API versioning for controller-based APIs. -->
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.0.0" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />

    <!-- Built-in OpenAPI document generation. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />

    <!--
      Pinned deliberately. The .NET 10 OpenAPI generator is built against the
      Microsoft.OpenApi 2.x object model; a transitive bump to 3.x makes several
      model properties read-only and breaks document generation.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />

    <!-- Documentation UIs. -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.16" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />

    <!-- Logging. Console, Debug and File sinks come along transitively. -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

</Project>
