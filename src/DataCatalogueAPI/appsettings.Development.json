{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "OpenApi": {
    "EnableUi": true
  },
  "Luggage": {
    "MaxFileSize": 104857600,
    "MaxExtractedSize": 524288000,
    "Archive": "c:\\temp"
  }
}
